{{!-- Ficha da Nave — Star Wars para Space Dragon.

      ── POR QUE AS ABAS DO SISTEMA ──────────────────────────────────────────

      A ficha nasceu como uma coluna só, com as treze seções empilhadas na ordem
      da rodada. Funcionava, e ficou longa: numa nave com câmaras, equipamentos,
      postos e energia, achar o armamento virava rolagem.

      Agora ela usa as MESMAS abas da ficha de personagem do sistema, com as
      mesmas classes (`sheet-container`, `sidebar`, `character-tab-*`). O ganho
      não é só visual — é que a aparência, o espaçamento e o comportamento ao
      encolher vêm do sistema, e param de ser CSS nosso para manter.

      O mapa, decidido com o autor:

        Ataques       o combate: estado da rodada, manobra, armamento
        Tipo          o perfil da T10-1 (era "Raça" no personagem)
        Câmaras       a T10-2 — as alterações estruturais (era "Classe")
        Tripulação    os cinco postos, energia, avarias e fuga (era "Poderes")
        Equipamentos  a T10-4 e o combustível
        Detalhes      as notas

      NÃO existe aba de atributos: uma nave não tem Força nem Intelecto. E a
      movimentação é UMA só, em hexes — os quatro campos do personagem (normal,
      escalada, voo, natação) não têm equivalente aqui.

      ── A RAIZ CONTINUA UM <div> ────────────────────────────────────────────

      E não um <form>: em ApplicationV2 a raiz da ficha já é um <form>, e o
      parser HTML descarta um <form> aninhado — a tag desaparecia, e com ela a
      classe que carrega o layout e a rolagem. --}}
<div class="starwars-sd-nave sheet-container">

  <header class="cabecalho">
    <img class="retrato" src="{{ator.img}}" data-edit="img" alt="{{ator.name}}">
    <div class="titulo">
      <input type="text" name="name" value="{{ator.name}}" placeholder="Nome da nave">
      <div class="linha-tipo">
        <select name="system.tipo">
          {{#each tipos}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{rotulo}} · {{tamanho}}</option>{{/each}}
        </select>
        <button type="button" data-action="aplicarTipo" title="Preenche BA, CP, JP, Velocidade, Esquiva e a fórmula de PV pela Tabela 10-1">
          aplicar tipo
        </button>
      </div>
      <p class="tabela">Tabela 10-1: tripulação {{s.perfil.tripulacao}} · movimento {{s.perfil.mov}}</p>
    </div>
  </header>

  <section class="barras">
    <div class="barra">
      <div class="rotulo">
        <span>Pontos de vida</span>
        <span class="nums">
          <input type="number" name="system.pv.value" value="{{s.pv.value}}"> /
          <input type="number" name="system.pv.max" value="{{s.pv.max}}">
        </span>
      </div>
      <div class="trilho"><div class="preenche pv" style="width:{{pctPV}}%"></div></div>
      <div class="acoes">
        <input type="text" name="system.pv.formula" value="{{s.pv.formula}}" title="Fórmula de PV do tipo">
        <button type="button" data-action="rolarPV">rolar</button>
      </div>
    </div>
  </section>

  <section class="sheet-body">
    <nav class="sheet-tabs tabs" data-group="primary">
      <a class="item active" data-tab="attacks">Ataques</a>
      <a class="item" data-tab="race">Tipo</a>
      <a class="item" data-tab="class">Câmaras</a>
      <a class="item" data-tab="spells">Tripulação</a>
      <a class="item" data-tab="equipment">Equipamentos</a>
      <a class="item" data-tab="details">Detalhes</a>
    </nav>

    <div class="tab character-tab-attacks active" data-tab="attacks">
  <section class="estado">
    <h3>Estado da rodada</h3>
    <div class="linha-estado">
      {{#if tatico}}
      <div class="sobrecarga" title="Manobra vermelha dá 1. Com Sobrecarga, nada de vermelha; uma verde tira 1.">
        <label>Sobrecarga</label>
        <button type="button" data-action="sobrecarga" data-delta="-1">−</button>
        <strong>{{s.sobrecarga}}</strong>
        <button type="button" data-action="sobrecarga" data-delta="1">+</button>
      </div>
      {{/if}}
      {{#if livro}}
      <div class="sobrecarga" title="§10.6: só nave pequena, e uma vez a cada 5 rodadas. Passando no teste de pilotagem, ataques contra ela são evitados por JP em vez do CP.">
        <label>Evasiva</label>
        <strong>{{#if s.evasiva.ativa}}ativa ({{#if s.evasiva.mod}}{{s.evasiva.mod}}{{else}}0{{/if}}){{else}}—{{/if}}</strong>
      </div>
      {{/if}}
      <button type="button" class="ficha trava {{#if s.trava}}ligada{{/if}}" data-action="trava"
              title="Sensores: +2 no próximo ataque aliado contra o alvo travado">
        Trava{{#if s.trava}} → {{s.trava}}{{/if}}
      </button>
    </div>
    <div class="avarias">
      {{#each avarias}}
      <button type="button" class="ficha {{#if ligada}}ligada avaria{{/if}}" data-action="avaria" data-chave="{{chave}}" title="{{efeito}}">{{rotulo}}</button>
      {{/each}}
    </div>
    <div class="botoes">
      {{#if tatico}}
      <button type="button" data-action="iniciativa" title="1d20 + Destreza do piloto — a ordem dos tiros">iniciativa</button>
      <button type="button" data-action="esquivar" title="Rola a Esquiva desta nave: cada 5–6 cancela um dado de dano">esquivar</button>
      {{else}}
      <button type="button" data-action="iniciativa" title="T10-6: o valor é a própria ação, e o menor age primeiro">ordem de ação</button>
      <button type="button" data-action="esquivar" {{#unless podeEvadir}}disabled{{/unless}}
              title="{{#if podeEvadir}}Teste de pilotagem; passando, ataques são evitados por JP em vez do CP{{else}}Só naves pequenas fazem manobras evasivas (§10.6){{/if}}">manobra evasiva</button>
      {{/if}}
      <button type="button" data-action="reparar" title="Engenharia: remove uma avaria, recupera 1d10 PV ou tira 1 Sobrecarga">reparar</button>
      <button type="button" data-action="fimDaRodada" title="Limpa a manobra e as avarias de uma rodada (Leme, Tripulação)">fim da rodada</button>
    </div>
  </section>

  <section class="dial">
    <h3>Regras do livro <span class="dica">Space Dragon §10.6</span></h3>
    <p class="tabela">Sem grid e sem dial: o combate segue a sequência do combate entre personagens. O disparo
      soma o BA da nave <em>e</em> o BA à distância de quem opera a arma, e uma arma atira por vez, desde que
      haja um tripulante em cada. A defesa é o CP; só nave pequena troca o CP por uma JP, com a manobra evasiva.
      O 20 natural e o 1 natural rolam as tabelas T10-6.</p>
  </section>

  <section class="dial">
    <h3>Manobra <span class="dica">planeje em segredo · mova na ordem crescente de Velocidade</span></h3>
    {{#unless escala.ok}}<p class="aviso-escala">{{{escala.motivo}}} O token não será movido.</p>{{/unless}}
    {{#if s.colosso}}<p class="dica-colosso">Colosso: só Reta, Inclinada e Parar.</p>{{/if}}
    <div class="manobras">
      {{#each dial}}
      <button type="button" class="mano {{cor}} {{#if bloqueada}}bloqueada{{/if}} {{#if (eq ../s.manobra.tipo tipo)}}{{#if (eq ../s.manobra.velocidade velocidade)}}{{#if (eq ../s.manobra.lado lado)}}escolhida{{/if}}{{/if}}{{/if}}"
              data-action="planejar" data-tipo="{{tipo}}" data-vel="{{velocidade}}" data-lado="{{lado}}" data-bloqueada="{{bloqueada}}"
              title="{{rotulo}} — giro {{giro}}° · {{cor}}">{{etiqueta}}</button>
      {{/each}}
    </div>
    <div class="planejada">
      {{#if manobraAtual}}
        <span class="{{#if s.manobra.revelada}}revelada{{else}}secreta{{/if}}">
          {{#if s.manobra.revelada}}executada: {{manobraAtual}}{{else}}planejada (em segredo){{/if}}
        </span>
      {{else}}<span class="secreta">nenhuma manobra planejada</span>{{/if}}
      <button type="button" data-action="revelar">mover</button>
    </div>
  </section>

  <section class="armamento">
    <h3>Armamento <span class="dica">marque o alvo (T) antes de atirar</span>
      <button type="button" class="mais" data-action="addArma" title="Adicionar arma">+</button></h3>
    {{#if s.armas.length}}
      <ul class="armas">
        {{#each s.armas as |arma i|}}
        <li>
          <input type="text" class="nome" name="system.armas.{{i}}.nome" value="{{arma.nome}}">
          <input type="text" class="dano" name="system.armas.{{i}}.dano" value="{{arma.dano}}" title="Dados de dano, ex.: 4d8">
          <select class="arco" name="system.armas.{{i}}.arco">
            <option value="frontal" {{#if (eq arma.arco "frontal")}}selected{{/if}}>frontal</option>
            <option value="livre" {{#if (eq arma.arco "livre")}}selected{{/if}}>qualquer arco</option>
          </select>
          <button type="button" class="atacar" data-action="atacar" data-idx="{{i}}">atirar</button>
          <button type="button" class="menos" data-action="delArma" data-idx="{{i}}" title="Remover">×</button>
        </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="vazio">Sem armamento. Use o <strong>+</strong>. Um caça leve atira com 4d8, um pesado com 5d8, um canhão de capital com 6d10 ou mais.</p>
    {{/if}}
  </section>
    </div>

    <div class="tab character-tab-race" data-tab="race">
  <section class="perfil">
    <div class="dado"><label>BA <span class="unid">casco</span></label><input type="number" name="system.ba" value="{{s.ba}}"></div>
    <div class="dado"><label>CP <span class="unid">casco</span></label><input type="number" name="system.cp" value="{{s.cp}}"></div>
    <div class="dado" title="Número-alvo: 1d20 + modificador ≥ JP. Menor é melhor."><label>JP</label><input type="number" name="system.jp" value="{{s.jp}}"></div>
    <div class="dado"><label>Velocidade <span class="unid">hex</span></label><input type="number" name="system.velocidade" value="{{s.velocidade}}" min="0"></div>
    <div class="dado"><label>Esquiva <span class="unid">d6</span></label><input type="number" name="system.esquiva" value="{{s.esquiva}}" min="0" max="5"></div>
    <div class="dado" title="Modificador de Destreza do piloto: Iniciativa = 1d20 + este número."><label>Iniciativa <span class="unid">DES</span></label><input type="number" name="system.iniciativa" value="{{s.iniciativa}}"></div>
  </section>
    </div>

    <div class="tab character-tab-class" data-tab="class">
  <section class="camaras">
    <h3>Câmaras <span class="dica">clique para trocar o estado · reparar custa 25% e leva metade do tempo</span></h3>
    {{#if semPonte}}
    <p class="aviso-escala">Sem a <strong>Ponte de Comando</strong> operacional, a nave não pode ser pilotada nem operar armas.</p>
    {{/if}}
    <div class="avarias">
      {{#each camaras}}
      <button type="button" class="ficha camara estado-{{estado}}" data-action="camara" data-chave="{{chave}}"
              title="{{rotulo}} — {{efeito}}&#10;&#10;Obra: {{obra}} CR · {{prazo}} (reparo: 25% e metade do tempo)&#10;Estado: {{estado}}">{{rotulo}}</button>
      {{/each}}
    </div>
    {{!-- Os testes que são DA NAVE: o salto rola na Ponte, e a tranca que se
          força é a do Arsenal. Quem rola é um personagem, mas o instrumento e a
          dificuldade são da nave. --}}
    <div class="botoes">
      <button type="button" data-action="salto"
              title="Os 3 testes de Pilotar do salto: Distância, Direção e Execução. Rola-se na Ponte de Comando.">salto hiperespacial</button>
      <button type="button" data-action="arsenal"
              title="Forçar as trancas do Arsenal: Sabotagem com −20%">forçar o arsenal</button>
    </div>
  </section>
    </div>

    <div class="tab character-tab-spells" data-tab="spells">
  <section class="postos">
    <h3>Postos <span class="dica">cada posto é a ação daquele personagem na rodada</span></h3>
    <div class="grade">
      {{#each postosComAcao}}
      <div class="posto">
        <label>{{rotulo}}</label>
        <input type="text" name="system.postos.{{chave}}" value="{{valor}}" placeholder="{{quem}}">
        <div class="linha-acao">
          <select class="acao" name="system.postoAcao.{{chave}}">
            <option value="">— ação —</option>
            {{#each acoes}}
            <option value="{{chave}}" {{#if sel}}selected{{/if}}>{{rotulo}}{{#unless automatica}} (à mão){{/unless}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="acaoPosto" data-posto="{{chave}}"
                  title="Executa a ação escolhida e manda o cartão para o chat">executar</button>
        </div>
        {{#if nota}}<p class="acao-posto">{{nota}}</p>{{/if}}
      </div>
      {{/each}}
    </div>
    {{#if firmado}}
    <p class="aviso-firmado">A nave está <strong>firmada</strong>: +4 na JP dela, +2 nos ataques, e ela não se move nesta rodada.</p>
    {{/if}}
  </section>

{{#if camadaEnergia}}
  <section class="energia">
    <h3>Energia <span class="dica">o reator dá {{energia.total}} por rodada · não acumula</span></h3>
    <div class="grade-energia">
      {{#each energia.destinos}}
      <div class="destino">
        <label>{{rotulo}}</label>
        <span class="pontos">{{valor}}</span>
        <span class="dica">{{efeito}}</span>
      </div>
      {{/each}}
    </div>
    <div class="linha">
      <span class="sobra {{#if energia.excedeu}}excedeu{{/if}}">
        {{#if energia.excedeu}}repartiu {{energia.gasta}} de {{energia.total}}{{else}}sobram {{energia.sobra}} de {{energia.total}}{{/if}}
      </span>
      <button type="button" data-action="energia">distribuir</button>
    </div>
    {{#if energia.resumo}}<p class="resumo-energia">{{energia.resumo}}</p>{{/if}}
  </section>
{{/if}}

{{#if camadaAvarias}}
  <section class="emergencias">
    <h3>Controle de avarias <span class="dica">resolver custa a ação de quem está na câmara</span></h3>
    {{#if emergencias.length}}
    <ul>
      {{#each emergencias}}
      <li class="{{#if venceu}}venceu{{/if}}">
        <strong>{{rotuloAvaria}}</strong> — {{rotuloCamara}} ·
        {{#if venceu}}<strong>prazo vencido</strong>: a câmara fica inoperante até reparo em porto
        {{else}}restam <strong>{{restam}}</strong> de {{prazo}} rodada(s){{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="dica">Nenhuma emergência a bordo.</p>
    {{/if}}
  </section>
{{/if}}

{{#if camadaFuga}}
  <section class="fuga">
    <h3>Fuga <span class="dica">quem fecha primeiro decide a cena — no empate, o perseguidor</span></h3>
    <div class="relogios">
      <div class="relogio">
        <label>Salto</label>
        <span class="marcas">{{fuga.etapas}}/3</span>
        <button type="button" data-action="etapaDoSalto" data-passo="1" title="Distância, Direção, Execução">+</button>
        <button type="button" data-action="etapaDoSalto" data-passo="-1">−</button>
      </div>
      <div class="relogio">
        <label>Perseguidor</label>
        <span class="marcas">{{fuga.perseguidor}}/{{fuga.marcas}}</span>
        <button type="button" data-action="perseguidor" data-passo="1" title="1 por rodada; 2 com avaria nova ou se a nave correu">+</button>
        <button type="button" data-action="perseguidor" data-passo="-1">−</button>
      </div>
    </div>
    {{#if fuga.fechou}}
    {{!-- dois booleanos do contexto em vez de um (eq fuga.fechou "salto"): o
          `eq` é usado em outros cinco pontos deste template e funciona, mas
          aqui o estado tem três valores (nenhum, salto, perseguidor) e dois
          booleanos dizem qual é sem comparar string. --}}
    <p class="fechou">
      {{#if fuga.saltou}}As três etapas fecharam: <strong>a nave salta</strong>.{{/if}}
      {{#if fuga.alcancada}}O relógio do perseguidor fechou: <strong>travão de raio e abordagem</strong>.{{/if}}
    </p>
    {{/if}}
  </section>
{{/if}}
    </div>

    <div class="tab character-tab-equipment" data-tab="equipment">
  <section class="equipamentos">
    <h3>Equipamentos <span class="dica">T10-4 · só o que cabe em nave {{s.perfil.tamanho}}</span></h3>
    <div class="grade-equip">
      {{#each equipamentos}}
      <button type="button" class="equip {{#if ligado}}ligado{{/if}} g-{{grupo}}"
              data-action="equipamento" data-chave="{{chave}}" title="{{nota}}">
        {{rotulo}}
      </button>
      {{/each}}
    </div>
    {{#if efeitosDeEquipamento.cp}}
    <p class="efeito-equip">Escudo de Força: <strong>+{{efeitosDeEquipamento.cp}}</strong> no CP enquanto durar.</p>
    {{/if}}
    {{#if conflitosDeEquipamento.length}}
    <p class="conflito-equip">
      Instalado mas <strong>fora do tamanho</strong> desta nave, e por isso sem efeito:
      {{#each conflitosDeEquipamento}}{{rotulo}}{{#unless @last}}, {{/unless}}{{/each}}.
    </p>
    {{/if}}
  </section>

  <section class="combustivel">
    <h3>Combustível <span class="dica">{{combustivel.fonte}} · autonomia {{combustivel.autonomia}}</span></h3>
    <div class="linha">
      <div class="barra-comb" title="{{combustivel.pct}}% do tanque">
        <div class="cheio" style="width: {{combustivel.pct}}%"></div>
      </div>
      <span class="pct-comb {{#unless combustivel.pct}}seco{{/unless}}">{{combustivel.pct}}%</span>
      <button type="button" data-action="combustivel" title="Gastar pela autonomia, ou abastecer">gastar / abastecer</button>
    </div>
    <select name="system.fonte" class="fonte">
      {{#each combustivel.fontes}}
      <option value="{{chave}}" {{#if sel}}selected{{/if}}>{{rotulo}} ({{raridade}} · {{autonomia}})</option>
      {{/each}}
    </select>
  </section>
    </div>

    <div class="tab character-tab-details" data-tab="details">
  <section class="notas">
    <h3>Notas</h3>
    {{formInput (lookup s "descricao") name="system.descricao" type="editorHTML" enriched=descricao toggled=true}}
  </section>
    </div>
  </section>
</div>
